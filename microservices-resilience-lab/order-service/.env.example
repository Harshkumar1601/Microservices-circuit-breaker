# Order Service Environment Variables
# Copy this file to .env and adjust values as needed

# Server Configuration
PORT=3001
NODE_ENV=development

# Inventory Service URL
INVENTORY_SERVICE_URL=http://localhost:3002

# Circuit Breaker Configuration
CB_TIMEOUT=3000
CB_ERROR_THRESHOLD_PERCENTAGE=50
CB_RESET_TIMEOUT=10000
CB_VOLUME_THRESHOLD=3
CB_ROLLING_COUNTER_TIMEOUT=10000

# CORS - comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,null

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
