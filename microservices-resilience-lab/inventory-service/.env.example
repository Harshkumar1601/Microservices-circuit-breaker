# Inventory Service Environment Variables
# Copy this file to .env and adjust values as needed

# Server Configuration
PORT=3002
NODE_ENV=development

# CORS - comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5500,http://127.0.0.1:5500,null

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# Simulation Mode (normal | failure | slow | recovery)
DEFAULT_SIMULATION_MODE=normal

# Slow mode delay in milliseconds (should exceed Order Service CB_TIMEOUT)
SLOW_MODE_DELAY=5000

# Demo token for simulation endpoints (optional basic protection)
# Leave blank to disable token check
DEMO_TOKEN=
